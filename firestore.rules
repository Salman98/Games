rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only read and write their own saves: users/{uid}/games/{packageName}
    match /users/{uid}/games/{game} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ints', 'longs', 'bools', 'strings', 'updatedAt']);
    }
  }
}
