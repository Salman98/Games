<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vibration for taps, line clears, mistakes and wins (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Daily "your puzzle is waiting" reminder (asked on the second launch, Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "More games": see which sister games are installed (Android 11+ package visibility). -->
    <queries>
        <package android:name="com.techeliteclub.game.blockpuzzle" />
        <package android:name="com.techeliteclub.game.colorsort" />
        <package android:name="com.techeliteclub.game.crownlogic" />
        <package android:name="com.techeliteclub.game.arrowescape" />
        <package android:name="com.techeliteclub.game.tilemahjong" />
        <package android:name="com.techeliteclub.game.sudoku" />
        <package android:name="com.techeliteclub.game.wordsearch" />
        <package android:name="com.techeliteclub.game.solitaire" />
        <package android:name="com.techeliteclub.game.carescape" />
        <package android:name="com.techeliteclub.game.merge2048" />
    </queries>

    <application>
        <!-- Each game can override @string/admob_app_id with its real AdMob app ID. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />
        <!-- Analytics: no advertising ID and no ad personalisation (AdMob handles ads on its own). -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
    </application>
</manifest>
